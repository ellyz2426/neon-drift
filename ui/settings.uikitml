<style>
  .panel { display:flex; flex-direction:column; padding:20; background-color:rgba(0,0,0,0.85); border-color:#00ffff; border-width:2; border-radius:12; }
  .title { font-size:26; color:#00ffff; text-align:center; margin-bottom:16; }
  .row { display:flex; flex-direction:row; justify-content:space-between; align-items:center; margin:8; }
  .label { font-size:16; color:#ffffff; }
  .value { font-size:16; color:#00ffff; }
  .btn { padding:10; background-color:#001133; border-color:#00ffff; border-width:2; border-radius:8; margin-top:12; }
  .btn-small { padding:6; background-color:#001133; border-color:#00ffff; border-width:1; border-radius:6; margin-left:6; }
  .btn-text { font-size:16; color:#88ffff; text-align:center; }
  .btn-text-small { font-size:14; color:#88ffff; text-align:center; }
</style>
<div class="panel">
  <span class="title">SETTINGS</span>
  <div class="row"><span class="label">Vehicle Skin</span><div class="row"><button id="btn_skin_prev" class="btn-small" cursor="pointer"><span class="btn-text-small"><</span></button><span id="skin_name" class="value">Cyan</span><button id="btn_skin_next" class="btn-small" cursor="pointer"><span class="btn-text-small">></span></button></div></div>
  <div class="row"><span class="label">Weather Rain</span><button id="btn_weather" class="btn-small" cursor="pointer"><span id="weather_val" class="btn-text-small">OFF</span></button></div>
  <div class="row"><span class="label">Master Volume</span><span class="value">60%</span></div>
  <button id="btn_back" class="btn" cursor="pointer"><span class="btn-text">BACK</span></button>
</div>
