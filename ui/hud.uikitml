<style>
  .hud { display:flex; flex-direction:column; padding:12; background-color:rgba(0,0,0,0.7); border-color:#00ffff; border-width:1; border-radius:8; }
  .row { display:flex; flex-direction:row; justify-content:space-between; margin:4; }
  .label { font-size:14; color:#88ffff; }
  .value { font-size:16; color:#00ffff; font-weight:bold; }
</style>
<div class="hud">
  <div class="row"><span class="label">SPEED</span><span id="speed" class="value">0 km/h</span></div>
  <div class="row"><span class="label">LAP</span><span id="lap" class="value">1 / 3</span></div>
  <div class="row"><span class="label">POS</span><span id="position" class="value">P1</span></div>
  <div class="row"><span class="label">BOOST</span><span id="boost" class="value">100%</span></div>
  <div class="row"><span class="label">TIME</span><span id="laptime" class="value">0.0s</span></div>
</div>
