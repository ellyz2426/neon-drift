<style>
  .panel { display:flex; flex-direction:column; padding:20; background-color:rgba(0,0,0,0.85); border-color:#00ffff; border-width:2; border-radius:12; }
  .title { font-size:28; color:#00ffff; text-align:center; margin-bottom:16; }
  .track { font-size:22; color:#ffffff; text-align:center; margin-bottom:12; }
  .btn { padding:12; background-color:#001133; border-color:#00ffff; border-width:2; border-radius:8; margin:8; }
  .btn-text { font-size:18; color:#00ffff; text-align:center; }
</style>
<div class="panel">
  <span class="title">SELECT TRACK</span>
  <span id="track_name" class="track">Holodeck Loop</span>
  <button id="btn_start" class="btn" cursor="pointer"><span class="btn-text">START RACE</span></button>
  <button id="btn_back" class="btn" cursor="pointer"><span class="btn-text">BACK</span></button>
</div>
